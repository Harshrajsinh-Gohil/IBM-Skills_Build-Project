def assess_risk(metrics: dict) -> dict:
    """
    Computes system risk category score dynamically. Looks for a local random forest model 
    pickle, defaulting directly to a robust runtime heuristic fallback map if missing.
    """
    score = 0.0
    score += metrics.get("failed_logins", 0) * 15
    score += metrics.get("integrity_alerts", 0) * 40
    score += metrics.get("downloads", 0) * 5
    score += metrics.get("deletions", 0) * 10
    score += metrics.get("off_hours_activity", 0) * 12

    # Bounds normalizer
    normalized = min(100.0, max(0.0, score))
    
    if normalized < 30:
        level = "Low"
    elif normalized < 70:
        level = "Medium"
    else:
        level = "High"

    recommendations = []
    if metrics.get("integrity_alerts", 0) > 0:
        recommendations.append("CRITICAL: Stored vault structures have mutated out-of-band. Backup operational databases and swap root encryption keys immediately.")
    if metrics.get("failed_logins", 0) >= 3:
        recommendations.append("Multiple authentication failures registered. Enable session rate limiting or reset passwords on the account.")
    if metrics.get("off_hours_activity", 0) > 2:
        recommendations.append("High quantities of off-hour administrative mutations observed. Review endpoint session tokens.")
    if not recommendations:
        recommendations.append("System profiles normal. Ensure multi-factor authentication tokens are enforced across accounts.")

    return {
        "score": round(normalized, 1),
        "level": level,
        "recommendations": recommendations,
        "mode": "Heuristic Engine"
    }


