class EncryptionError(Exception):
    pass


class EncryptedPayload:
    def __init__(self, ciphertext, nonce, encrypted_sha256_hash, encrypted_key, key_nonce):
        self.ciphertext = ciphertext
        self.nonce = nonce
        self.encrypted_sha256_hash = encrypted_sha256_hash
        self.encrypted_key = encrypted_key
        self.key_nonce = key_nonce


def hash_password(password: str) -> str:
    """Mock implementation or entrypoint for bcrypt password hashing."""
    import bcrypt
    salt = bcrypt.gensalt()
    return bcrypt.hashpw(password.encode('utf-8'), salt).decode('utf-8')


def verify_password(password: str, hashed: str) -> bool:
    """Verifies a password against its bcrypt hash value."""
    import bcrypt
    try:
        return bcrypt.checkpw(password.encode('utf-8'), hashed.encode('utf-8'))
    except Exception:
        return False


def sha256_bytes(data: bytes) -> str:
    import hashlib
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    import hashlib
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        while chunk := f.read(8192):
            h.update(chunk)
    return h.hexdigest()


def hashes_match(hash1: str, hash2: str) -> bool:
    if hash1 is None or hash2 is None:
        return False
    return secrets.compare_digest(hash1.lower(), hash2.lower())


def generate_master_key() -> str:
    """Generates a secure, shareable master key string."""
    return secrets.token_hex(32)


def load_master_key(env_key: str | None, file_path: Path) -> bytes:
    """Retrieves or provisions the primary deployment cryptographic key."""
    if env_key:
        try:
            return bytes.fromhex(env_key)
        except ValueError:
            return env_key.encode('utf-8').ljust(32, b'\x00')[:32]
            
    if file_path.exists():
        try:
            return bytes.fromhex(file_path.read_text().strip())
        except ValueError:
            return file_path.read_bytes().ljust(32, b'\x00')[:32]

    # Generate a brand new fallback key if missing
    new_key_hex = generate_master_key()
    file_path.parent.mkdir(parents=True, exist_ok=True)
    file_path.write_text(new_key_hex)
    return bytes.fromhex(new_key_hex)


def encrypt_bytes(data: bytes, master_key: bytes) -> EncryptedPayload:
    """Encrypts bytes using AES-GCM with envelope key protection."""
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    
    # Generate unique per-file data key
    data_key = AESGCM.generate_key(bit_length=256)
    aesgcm_data = AESGCM(data_key)
    
    file_nonce = secrets.token_bytes(12)
    ciphertext = aesgcm_data.encrypt(file_nonce, data, None)
    
    # Wrap the data key using the master key
    aesgcm_master = AESGCM(master_key)
    key_nonce = secrets.token_bytes(12)
    wrapped_key = aesgcm_master.encrypt(key_nonce, data_key, None)
    
    return EncryptedPayload(
        ciphertext=ciphertext,
        nonce=file_nonce.hex(),
        encrypted_sha256_hash=sha256_bytes(ciphertext),
        encrypted_key=wrapped_key.hex(),
        key_nonce=key_nonce.hex()
    )


def decrypt_bytes(ciphertext: bytes, nonce: str, encrypted_key: str, key_nonce: str, master_key: bytes) -> bytes:
    """Decrypts ciphertext using envelope wrapping validation checking."""
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    
    try:
        aesgcm_master = AESGCM(master_key)
        data_key = aesgcm_master.decrypt(
            bytes.fromhex(key_nonce), 
            bytes.fromhex(encrypted_key), 
            None
        )
        
        aesgcm_data = AESGCM(data_key)
        return aesgcm_data.decrypt(bytes.fromhex(nonce), ciphertext, None)
    except Exception as e:
        raise EncryptionError("Decryption layer parsing or data authenticity validation failed.") from e


