# Helper Decorators and Form Validations
def login_required(view):
    @wraps(view)
    def wrapped(*args, **kwargs):
        if not session.get("user_id"):
            flash("Please log in to continue.", "warning")
            return redirect(url_for("login", next=request.path))
        return view(*args, **kwargs)
    return wrapped


def _ensure_directories(app: Flask):
    for key in (
        "DATABASE_PATH",
        "ENCRYPTED_FOLDER",
        "UPLOAD_FOLDER",
        "DECRYPTED_FOLDER",
        "LOG_FOLDER",
        "MASTER_KEY_PATH",
    ):
        path = Path(app.config[key])
        directory = path.parent if path.suffix else path
        directory.mkdir(parents=True, exist_ok=True)


def _current_user():
    user_id = session.get("user_id")
    if not user_id:
        return None
    with get_connection() as conn:
        return user_model.get_user_by_id(conn, user_id)


def _csrf_field():
    token = session.get("_csrf_token")
    if not token:
        token = secrets.token_urlsafe(32)
        session["_csrf_token"] = token
    escaped = html.escape(token, quote=True)
    return Markup(f'<input type="hidden" name="_csrf_token" value="{escaped}">')


def _request_audit_context() -> dict:
    forwarded_for = request.headers.get("X-Forwarded-For", "")
    ip_address = forwarded_for.split(",")[0].strip() or request.remote_addr
    user_agent = request.headers.get("User-Agent", "")[:255]
    return {"ip_address": ip_address, "user_agent": user_agent}


def _validate_registration(
    username: str, email: str, password: str, confirm_password: str
) -> list[str]:
    errors: list[str] = []
    if len(username) < 3:
        errors.append("Username must be at least 3 characters.")
    if "@" not in email or "." not in email.rsplit("@", 1)[-1]:
        errors.append("Enter a valid email address.")
    if len(password) < 10:
        errors.append("Password must be at least 10 characters.")
    if password != confirm_password:
        errors.append("Passwords do not match.")
    return errors


def _allowed_file(filename: str, allowed_extensions: set[str]) -> bool:
    return "." in filename and Path(filename).suffix.lower().lstrip(".") in allowed_extensions


def _safe_next_url(target: str | None) -> str | None:
    if target and target.startswith("/") and not target.startswith("//"):
        return target
    return None


def _verify_and_decrypt(conn, vault_file):
    from flask import current_app
    encrypted_path = Path(current_app.config["ENCRYPTED_FOLDER"]) / vault_file.encrypted_name
    if not encrypted_path.exists():
        message = f"Integrity alert: encrypted file missing for {vault_file.original_filename}."
        _record_integrity_alert(conn, vault_file, "CRITICAL", message)
        return False, message, b""

    actual_encrypted_hash = sha256_file(encrypted_path)
    if not hashes_match(vault_file.encrypted_sha256_hash, actual_encrypted_hash):
        message = f"Integrity alert: encrypted blob changed for {vault_file.original_filename}."
        _record_integrity_alert(conn, vault_file, "CRITICAL", message)
        return False, message, b""

    ciphertext = encrypted_path.read_bytes()
    try:
        plaintext = decrypt_bytes(
            ciphertext,
            nonce=vault_file.nonce,
            encrypted_key=vault_file.encrypted_key,
            key_nonce=vault_file.key_nonce,
            master_key=current_app.config["MASTER_KEY_BYTES"],
        )
    except EncryptionError:
        message = f"Integrity alert: decryption authentication failed for {vault_file.original_filename}."
        _record_integrity_alert(conn, vault_file, "CRITICAL", message)
        return False, message, b""

    actual_plaintext_hash = sha256_bytes(plaintext)
    if not hashes_match(vault_file.sha256_hash, actual_plaintext_hash):
        message = f"Integrity alert: plaintext hash mismatch for {vault_file.original_filename}."
        _record_integrity_alert(conn, vault_file, "HIGH", message)
        return False, message, b""

    file_model.update_verification_time(conn, vault_file.id)
    return True, f"Integrity verified for {vault_file.original_filename}.", plaintext


def _record_integrity_alert(conn, vault_file, severity: str, message: str):
    audit_model.create_alert(
        conn,
        user_id=vault_file.user_id,
        file_id=vault_file.id,
        severity=severity,
        message=message,
    )
    audit_model.log_event(
        conn,
        user_id=vault_file.user_id,
        action="INTEGRITY_ALERT",
        details=message,
        **_request_audit_context(),
    )


