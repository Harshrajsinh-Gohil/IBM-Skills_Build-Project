class UserRecord:
    def __init__(self, row):
        self.id = row["id"]
        self.username = row["username"]
        self.email = row["email"]
        self.password_hash = row["password_hash"]
        self.created_at = row["created_at"]


class VaultFileRecord:
    def __init__(self, row):
        self.id = row["id"]
        self.user_id = row["user_id"]
        self.original_filename = row["original_filename"]
        self.encrypted_name = row["encrypted_name"]
        self.file_extension = row["file_extension"]
        self.mime_type = row["mime_type"]
        self.size_bytes = row["size_bytes"]
        self.sha256_hash = row["sha256_hash"]
        self.encrypted_sha256_hash = row["encrypted_sha256_hash"]
        self.nonce = row["nonce"]
        self.encrypted_key = row["encrypted_key"]
        self.key_nonce = row["key_nonce"]
        self.upload_time = row["upload_time"]
        self.last_verified_at = row["last_verified_at"]


# User database patterns
class user_model:
    @staticmethod
    def create_user(conn, username, email, password_hash) -> UserRecord:
        now = datetime.utcnow().isoformat()
        cursor = conn.cursor()
        try:
            cursor.execute(
                "INSERT INTO users (username, email, password_hash, created_at) VALUES (?, ?, ?, ?)",
                (username, email, password_hash, now)
            )
            conn.commit()
            return user_model.get_user_by_id(conn, cursor.lastrowid)
        except sqlite3.IntegrityError as e:
            if "username" in str(e).lower():
                raise ValueError("Username is already taken.")
            raise ValueError("Email address is already registered.")

    @staticmethod
    def get_user_by_id(conn, user_id) -> UserRecord | None:
        row = conn.execute("SELECT * FROM users WHERE id = ?", (user_id,)).fetchone()
        return UserRecord(row) if row else None

    @staticmethod
    def find_user_by_identifier(conn, identifier) -> UserRecord | None:
        row = conn.execute(
            "SELECT * FROM users WHERE username = ? OR email = ?", (identifier, identifier)
        ).fetchone()
        return UserRecord(row) if row else None


# File database patterns
class file_model:
    @staticmethod
    def create_file_record(conn, **kwargs) -> VaultFileRecord:
        now = datetime.utcnow().isoformat()
        cursor = conn.cursor()
        cursor.execute(
            """INSERT INTO files (
                user_id, original_filename, encrypted_name, file_extension, mime_type,
                size_bytes, sha256_hash, encrypted_sha256_hash, nonce, encrypted_key, 
                key_nonce, upload_time
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
            (
                kwargs["user_id"], kwargs["original_filename"], kwargs["encrypted_name"],
                kwargs["file_extension"], kwargs["mime_type"], kwargs["size_bytes"],
                kwargs["sha256_hash"], kwargs["encrypted_sha256_hash"], kwargs["nonce"],
                kwargs["encrypted_key"], kwargs["key_nonce"], now
            )
        )
        conn.commit()
        return file_model.get_file_for_user(conn, cursor.lastrowid, kwargs["user_id"])

    @staticmethod
    def get_file_for_user(conn, file_id, user_id) -> VaultFileRecord | None:
        row = conn.execute(
            "SELECT * FROM files WHERE id = ? AND user_id = ?", (file_id, user_id)
        ).fetchone()
        return VaultFileRecord(row) if row else None

    @staticmethod
    def list_user_files(conn, user_id, limit=8) -> list[VaultFileRecord]:
        rows = conn.execute(
            "SELECT * FROM files WHERE user_id = ? ORDER BY upload_time DESC LIMIT ?",
            (user_id, limit)
        ).fetchall()
        return [VaultFileRecord(r) for r in rows]

    @staticmethod
    def count_user_files(conn, user_id) -> int:
        return conn.execute("SELECT COUNT(*) FROM files WHERE user_id = ?", (user_id,)).fetchone()[0]

    @staticmethod
    def update_verification_time(conn, file_id):
        now = datetime.utcnow().isoformat()
        conn.execute("UPDATE files SET last_verified_at = ? WHERE id = ?", (now, file_id))
        conn.commit()

    @staticmethod
    def delete_file_record(conn, file_id, user_id):
        conn.execute("DELETE FROM files WHERE id = ? AND user_id = ?", (file_id, user_id))
        conn.commit()


# Logs and Alerts database patterns
class audit_model:
    @staticmethod
    def log_event(conn, user_id, action, details, ip_address, user_agent):
        now = datetime.utcnow().isoformat()
        conn.execute(
            "INSERT INTO logs (user_id, action, details, ip_address, user_agent, timestamp) VALUES (?, ?, ?, ?, ?, ?)",
            (user_id, action, details, ip_address, user_agent, now)
        )
        conn.commit()

    @staticmethod
    def create_alert(conn, user_id, file_id, severity, message):
        now = datetime.utcnow().isoformat()
        conn.execute(
            "INSERT INTO alerts (user_id, file_id, severity, message, timestamp) VALUES (?, ?, ?, ?, ?)",
            (user_id, file_id, severity, message, now)
        )
        conn.commit()

    @staticmethod
    def resolve_alert(conn, alert_id, user_id):
        conn.execute("UPDATE alerts SET resolved = 1 WHERE id = ? AND user_id = ?", (alert_id, user_id))
        conn.commit()

    @staticmethod
    def list_recent_logs(conn, user_id, limit=8) -> list[sqlite3.Row]:
        return conn.execute(
            "SELECT * FROM logs WHERE user_id = ? OR user_id IS NULL ORDER BY timestamp DESC LIMIT ?",
            (user_id, limit)
        ).fetchall()

    @staticmethod
    def list_user_alerts(conn, user_id, include_resolved=False, limit=5) -> list[sqlite3.Row]:
        if include_resolved:
            return conn.execute(
                "SELECT * FROM alerts WHERE user_id = ? ORDER BY timestamp DESC LIMIT ?", (user_id, limit)
            ).fetchall()
        return conn.execute(
            "SELECT * FROM alerts WHERE user_id = ? AND resolved = 0 ORDER BY timestamp DESC LIMIT ?",
            (user_id, limit)
        ).fetchall()

    @staticmethod
    def security_metrics(conn, user_id, window_hours: int) -> dict:
        """Assembles metrics data from the database over the trailing period."""
        cutoff = (datetime.utcnow() - timedelta(hours=window_hours)).isoformat()
        
        failed_logins = conn.execute(
            "SELECT COUNT(*) FROM logs WHERE action = 'FAILED_LOGIN' AND timestamp >= ?", (cutoff,)
        ).fetchone()[0]
        
        integrity_alerts = conn.execute(
            "SELECT COUNT(*) FROM alerts WHERE user_id = ? AND timestamp >= ?", (user_id, cutoff)
        ).fetchone()[0]
        
        downloads = conn.execute(
            "SELECT COUNT(*) FROM logs WHERE user_id = ? AND action = 'DOWNLOAD' AND timestamp >= ?",
            (user_id, cutoff)
        ).fetchone()[0]
        
        deletions = conn.execute(
            "SELECT COUNT(*) FROM logs WHERE user_id = ? AND action = 'DELETE' AND timestamp >= ?",
            (user_id, cutoff)
        ).fetchone()[0]

        # Scan for off-hours activity (11 PM - 5 AM UTC placeholder metrics)
        off_hours_count = 0
        log_times = conn.execute(
            "SELECT timestamp FROM logs WHERE user_id = ? AND timestamp >= ?", (user_id, cutoff)
        ).fetchall()
        for row in log_times:
            try:
                dt = datetime.fromisoformat(row["timestamp"])
                if dt.hour >= 23 or dt.hour < 5:
                    off_hours_count += 1
            except Exception:
                pass

        return {
            "failed_logins": failed_logins,
            "integrity_alerts": integrity_alerts,
            "downloads": downloads,
            "deletions": deletions,
            "off_hours_activity": off_hours_count,
        }


