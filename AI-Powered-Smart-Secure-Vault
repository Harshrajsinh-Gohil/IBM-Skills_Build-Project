def create_app(config_object=Config, test_config: dict | None = None) -> Flask:
    app = Flask(__name__)
    app.config.from_object(config_object)
    if test_config:
        app.config.update(test_config)

    app.config["PERMANENT_SESSION_LIFETIME"] = timedelta(
        seconds=int(app.config.get("PERMANENT_SESSION_LIFETIME_SECONDS", 3600))
    )

    _ensure_directories(app)
    init_db(app)
    app.config["MASTER_KEY_BYTES"] = load_master_key(
        app.config.get("MASTER_KEY"), Path(app.config["MASTER_KEY_PATH"])
    )

    @app.before_request
    def harden_session_and_csrf():
        session.permanent = True
        if not app.config.get("ENABLE_CSRF", True):
            return
        if request.method in {"POST", "PUT", "PATCH", "DELETE"}:
            token = session.get("_csrf_token")
            submitted = request.form.get("_csrf_token")
            if not token or not submitted or not secrets.compare_digest(token, submitted):
                abort(400, description="Invalid form token.")

    @app.context_processor
    def inject_template_helpers():
        return {
            "current_user": _current_user(),
            "csrf_field": _csrf_field,
        }

    @app.after_request
    def add_security_headers(response):
        response.headers.setdefault("X-Content-Type-Options", "nosniff")
        response.headers.setdefault("X-Frame-Options", "DENY")
        response.headers.setdefault("Referrer-Policy", "strict-origin-when-cross-origin")
        response.headers.setdefault(
            "Permissions-Policy",
            "camera=(), microphone=(), geolocation=()",
        )
        return response

    @app.template_filter("datetime")
    def format_datetime(value):
        if not value:
            return "Never"
        return str(value).replace("T", " ").split(".")[0]

    @app.template_filter("filesize")
    def format_filesize(size):
        size = float(size or 0)
        for unit in ("B", "KB", "MB", "GB"):
            if size < 1024 or unit == "GB":
                return f"{size:.0f} {unit}" if unit == "B" else f"{size:.1f} {unit}"
            size /= 1024
        return f"{size:.1f} GB"

    @app.errorhandler(RequestEntityTooLarge)
    def upload_too_large(_error):
        flash("That file is larger than the configured upload limit.", "danger")
        return redirect(url_for("upload"))

    @app.errorhandler(400)
    def bad_request(error):
        flash(getattr(error, "description", "Bad request."), "danger")
        return redirect(request.referrer or url_for("index"))

    @app.route("/")
    def index():
        if session.get("user_id"):
            return redirect(url_for("dashboard"))
        return redirect(url_for("login"))

    @app.route("/register", methods=["GET", "POST"])
    def register():
        if session.get("user_id"):
            return redirect(url_for("dashboard"))

        if request.method == "POST":
            username = request.form.get("username", "").strip()
            email = request.form.get("email", "").strip().lower()
            password = request.form.get("password", "")
            confirm_password = request.form.get("confirm_password", "")

            errors = _validate_registration(username, email, password, confirm_password)
            if errors:
                for error in errors:
                    flash(error, "danger")
                return render_template("register.html"), 422

            with get_connection() as conn:
                try:
                    user = user_model.create_user(
                        conn,
                        username=username,
                        email=email,
                        password_hash=hash_password(password),
                    )
                except ValueError as exc:
                    flash(str(exc), "danger")
                    return render_template("register.html"), 409

                audit_model.log_event(
                    conn,
                    user_id=user.id,
                    action="REGISTER",
                    details="Account created.",
                    **_request_audit_context(),
                )

            session.clear()
            session["user_id"] = user.id
            flash("Account created. Your secure vault is ready.", "success")
            return redirect(url_for("dashboard"))

        return render_template("register.html")

    @app.route("/login", methods=["GET", "POST"])
    def login():
        if session.get("user_id"):
            return redirect(url_for("dashboard"))

        if request.method == "POST":
            identifier = request.form.get("identifier", "").strip()
            password = request.form.get("password", "")

            with get_connection() as conn:
                user = user_model.find_user_by_identifier(conn, identifier)
                password_ok = bool(user and verify_password(password, user.password_hash))

                if not password_ok:
                    audit_model.log_event(
                        conn,
                        user_id=user.id if user else None,
                        action="FAILED_LOGIN",
                        details=f"Failed login attempt for {identifier[:80]}.",
                        **_request_audit_context(),
                    )
                    flash("Invalid username/email or password.", "danger")
                    return render_template("login.html"), 401

                session.clear()
                session["user_id"] = user.id
                audit_model.log_event(
                    conn,
                    user_id=user.id,
                    action="LOGIN",
                    details="Successful login.",
                    **_request_audit_context(),
                )

            flash("Welcome back.", "success")
            return redirect(_safe_next_url(request.args.get("next")) or url_for("dashboard"))

        return render_template("login.html")

    @app.route("/logout", methods=["POST"])
    @login_required
    def logout():
        user_id = session.get("user_id")
        with get_connection() as conn:
            audit_model.log_event(
                conn,
                user_id=user_id,
                action="LOGOUT",
                details="User logged out.",
                **_request_audit_context(),
            )
        session.clear()
        flash("You have been logged out.", "info")
        return redirect(url_for("login"))

    @app.route("/dashboard")
    @login_required
    def dashboard():
        user_id = session["user_id"]
        with get_connection() as conn:
            files = file_model.list_user_files(conn, user_id, limit=8)
            total_files = file_model.count_user_files(conn, user_id)
            recent_logs = audit_model.list_recent_logs(conn, user_id, limit=8)
            alerts = audit_model.list_user_alerts(conn, user_id, include_resolved=False, limit=5)
            metrics = audit_model.security_metrics(
                conn, user_id, app.config["RISK_WINDOW_HOURS"]
            )
        risk = assess_risk(metrics)
        return render_template(
            "dashboard.html",
            files=files,
            total_files=total_files,
            recent_logs=recent_logs,
            alerts=alerts,
            metrics=metrics,
            risk=risk,
        )

    @app.route("/upload", methods=["GET", "POST"])
    @login_required
    def upload():
        if request.method == "POST":
            uploaded_file = request.files.get("file")
            if not uploaded_file or not uploaded_file.filename:
                flash("Choose a file to upload.", "danger")
                return render_template("upload.html"), 422

            filename = secure_filename(uploaded_file.filename)
            if not filename:
                flash("The filename is not valid.", "danger")
                return render_template("upload.html"), 422
            if not _allowed_file(filename, app.config["ALLOWED_EXTENSIONS"]):
                flash("Only PDF, DOCX, TXT, JPG, JPEG, and PNG files are allowed.", "danger")
                return render_template("upload.html"), 415

            raw_data = uploaded_file.read()
            if not raw_data:
                flash("Empty files cannot be stored in the vault.", "danger")
                return render_template("upload.html"), 422

            encrypted_payload = encrypt_bytes(raw_data, app.config["MASTER_KEY_BYTES"])
            encrypted_name = f"{uuid.uuid4().hex}.bin"
            encrypted_path = Path(app.config["ENCRYPTED_FOLDER"]) / encrypted_name
            encrypted_path.write_bytes(encrypted_payload.ciphertext)

            extension = Path(filename).suffix.lower().lstrip(".")
            mime_type = mimetypes.guess_type(filename)[0] or uploaded_file.mimetype

            with get_connection() as conn:
                vault_file = file_model.create_file_record(
                    conn,
                    user_id=session["user_id"],
                    original_filename=filename,
                    encrypted_name=encrypted_name,
                    file_extension=extension,
                    mime_type=mime_type,
                    size_bytes=len(raw_data),
                    sha256_hash=sha256_bytes(raw_data),
                    encrypted_sha256_hash=encrypted_payload.encrypted_sha256_hash,
                    nonce=encrypted_payload.nonce,
                    encrypted_key=encrypted_payload.encrypted_key,
                    key_nonce=encrypted_payload.key_nonce,
                )
                audit_model.log_event(
                    conn,
                    user_id=session["user_id"],
                    action="UPLOAD",
                    details=f"Uploaded {vault_file.original_filename}.",
                    **_request_audit_context(),
                )

            flash("File encrypted and stored successfully.", "success")
            return redirect(url_for("dashboard"))

        return render_template("upload.html")

    @app.route("/files/<int:file_id>/download")
    @login_required
    def download_file(file_id: int):
        with get_connection() as conn:
            vault_file = file_model.get_file_for_user(
                conn, file_id=file_id, user_id=session["user_id"]
            )
            if not vault_file:
                abort(404)

            ok, message, plaintext = _verify_and_decrypt(conn, vault_file)
            if not ok:
                flash(message, "danger")
                return redirect(url_for("dashboard"))

            audit_model.log_event(
                conn,
                user_id=session["user_id"],
                action="DOWNLOAD",
                details=f"Downloaded {vault_file.original_filename}.",
                **_request_audit_context(),
            )

        return send_file(
            BytesIO(plaintext),
            as_attachment=True,
            download_name=vault_file.original_filename,
            mimetype=vault_file.mime_type or "application/octet-stream",
        )

